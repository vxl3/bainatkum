# عنوان مشروع Supabase الخاص بك (من إعدادات المشروع > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# المفتاح العام (anon key) - آمن للاستخدام في المتصفح
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# مفتاح الخادم (service role) - لا يُستخدم إلا داخل كود الخادم فقط
# ولا يجب أن يصل إلى المتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# رابط الموقع الفعلي بعد النشر (أو localhost أثناء التطوير)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
